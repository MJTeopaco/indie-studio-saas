# ml-engine/.env.example
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to ml-engine/.env and populate with real values.
# .env is listed in .gitignore and must NEVER be committed.
# ─────────────────────────────────────────────────────────────────────────────

# ── Groq Cloud API ────────────────────────────────────────────────────────────
# Obtain your key at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Model identifier — must be a valid Groq-hosted model ID.
# https://console.groq.com/docs/models
# Default used by llm_client.py when this var is absent: openai/gpt-oss-120b
GROQ_MODEL=openai/gpt-oss-120b
